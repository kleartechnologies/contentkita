# ContentKita — Firebase Web configuration
#
# Copy this file to .env.local and fill in the values from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
#
# These six values are the Firebase *Web* configuration. They are delivered to
# every browser that loads the app and are public by design — access is enforced
# by Firebase Authentication and the Firestore Security Rules in firestore.rules,
# not by keeping this config hidden.
#
# A service account key, an Admin SDK credential or any private key must NEVER
# be put in a NEXT_PUBLIC_* variable: that prefix inlines the value into the
# client bundle. ContentKita does use a server-side Firebase credential since
# M5 — see FIREBASE_SERVICE_ACCOUNT_* below — and it is deliberately not
# prefixed, not imported by any client file, and not committed anywhere.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# AI content generation (server-side only)
#
# OPENAI_API_KEY is a SECRET. It has no NEXT_PUBLIC_ prefix on purpose: that
# prefix inlines a value into the browser bundle, and this key must never leave
# the server. It is read only by lib/ai/openai.ts, which is marked `server-only`
# so an accidental import from a client component fails the build instead of
# shipping the key.
#
# In production the value lives in the Netlify site's environment variables
# (Site configuration → Environment variables) and is read at runtime by the
# /api/generate route handler. It is never committed, and never pasted into a
# source file.
#
# Requests flow: browser → /api/generate (server) → OpenAI. The browser never
# holds a provider credential and never talks to a provider directly.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1.
OPENAI_MODEL=

# Optional, for local development only. Points the transport at a stand-in
# OpenAI-compatible endpoint so the full flow can be exercised without a real
# key. Leave unset in production.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Server-side Firestore access (M5, payments)
#
# The payment callback has to write documents that no browser may write: the
# order it marks paid, and the pack that entitlement creates. It arrives from
# Billplz with no user session at all, so there is no owner credential to act
# under — it authenticates as the project instead, through a service account
# restricted to a single role, roles/datastore.user.
#
# Both values are SECRETS.
#
#   FIREBASE_SERVICE_ACCOUNT_EMAIL        client_email from the service account
#   FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY  private_key from the same JSON file
#
# The private key is multi-line PEM. Keep it on one line with literal \n
# escapes, wrapped in double quotes — lib/server/google-token.ts turns the
# escapes back into newlines. Set it in Netlify with `netlify env:set` reading
# from a file, so the value is never echoed to a terminal, pasted into a chat
# or written into the repository.
#
# Read only by lib/server/google-token.ts, which is marked `server-only`: an
# import from a client component fails the build rather than shipping a key.
# The project id comes from NEXT_PUBLIC_FIREBASE_PROJECT_ID above, which is
# public and fine to share.
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Billplz (M5, payments — server-side only)
#
# ContentKita sells one thing: a 30-day content pack for RM39.90, paid once.
# There is no subscription and no recurring billing, so there is no stored card
# and no token to keep. Billplz hosts the payment page; the browser is sent
# there and comes back.
#
# BILLPLZ_BASE_URL        https://www.billplz-sandbox.com for development,
#                         https://www.billplz.com for production. Nothing here
#                         switches between them automatically — that is a
#                         deliberate, human change of a deployed variable.
# BILLPLZ_COLLECTION_ID   the collection bills are created in. Checked against
#                         every callback, so a bill from another collection
#                         cannot fulfil an order.
# BILLPLZ_SECRET_KEY      SECRET. Used as the username of HTTP Basic auth when
#                         creating a bill, with an empty password. It is read
#                         only by lib/payment/billplz.ts (`server-only`) and
#                         never appears in a URL, a body, a log or a response.
# BILLPLZ_X_SIGNATURE_KEY SECRET. The HMAC-SHA256 key the callback's
#                         x_signature is verified against. This is what makes a
#                         payment true; without it a POST claiming "paid=true"
#                         is just a POST.
#
# None of these four may ever be given a NEXT_PUBLIC_ prefix. There is no
# browser code path that needs any of them, and there never should be.
BILLPLZ_BASE_URL=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SECRET_KEY=
BILLPLZ_X_SIGNATURE_KEY=

# ---------------------------------------------------------------------------
# Where this deployment lives
#
# Optional. Used to build the callback and redirect URLs handed to Billplz.
# Netlify sets URL and DEPLOY_PRIME_URL by itself, and the request's own host
# is the last resort, so this is only needed when the public address differs
# from what the platform reports.
NEXT_PUBLIC_SITE_URL=
