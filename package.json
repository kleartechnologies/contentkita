{
  "name": "contentkita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test \"lib/**/*.test.ts\"",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "ai:cost": "node scripts/ai-cost.ts",
    "ai:bench": "node --conditions=react-server --env-file=.env.local scripts/ai-bench.ts",
    "verify:firebase": "node --conditions=react-server --env-file=.env.local scripts/verify-firebase.mjs",
    "preview": "node --conditions=react-server scripts/preview.ts",
    "test:flow": "node scripts/flow.mjs",
    "test:responsive": "node scripts/responsive.mjs",
    "test:cleanup": "node --conditions=react-server --env-file=.env.local scripts/cleanup-flow.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
