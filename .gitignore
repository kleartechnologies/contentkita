# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
Thumbs.db
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed, the template does
.env*
!.env.example

# firebase — credentials, emulator state and CLI noise
serviceAccount*.json
*-firebase-adminsdk-*.json
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/
.firebaserc.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Throwaway credentials written by scripts/flow.mjs; never committed.
scripts/.flow-accounts

# Netlify CLI link state and its Deno edge-function scratch — local only.
.netlify
deno.lock

# Benchmark output — generated months, read locally, never committed.
# One directory per run (`--out=`), so the glob rather than the bare name.
/.bench*
# Contact sheets from `npm run preview`. Renders of the product, not source.
.preview*/
